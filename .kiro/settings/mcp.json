{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "fetch"
      ]
    },
    "brave-search": {
      "command": "/home/neeyuhuynh/Desktop/DILIV2/brave-search-wrapper.sh",
      "args": [],
      "env": {
        "BRAVE_API_KEY": "YOUR_BRAVE_API_KEY_HERE"
      },
      "disabled": false,
      "autoApprove": [
        "search"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN_HERE"
      },
      "disabled": false,
      "autoApprove": [
        "search_repositories",
        "get_file_contents",
        "create_issue"
      ]
    },
    "slack": {
      "command": "uvx",
      "args": [
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "YOUR_SLACK_BOT_TOKEN_HERE"
      },
      "disabled": true,
      "autoApprove": [
        "list_channels",
        "send_message",
        "get_channel_history"
      ]
    },
    "everart": {
      "command": "uvx",
      "args": [
        "@modelcontextprotocol/server-everart"
      ],
      "env": {
        "EVERART_API_KEY": "YOUR_EVERART_API_KEY_HERE"
      },
      "disabled": true,
      "autoApprove": [
        "generate_image",
        "get_image_status"
      ]
    },
    "aws-kb": {
      "command": "uvx",
      "args": [
        "@modelcontextprotocol/server-aws-kb"
      ],
      "env": {
        "AWS_ACCESS_KEY_ID": "YOUR_AWS_ACCESS_KEY_HERE",
        "AWS_SECRET_ACCESS_KEY": "YOUR_AWS_SECRET_KEY_HERE",
        "AWS_REGION": "us-east-1"
      },
      "disabled": true,
      "autoApprove": [
        "query_knowledge_base",
        "retrieve_documents"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "think_step_by_step",
        "analyze_problem",
        "break_down_task",
        "sequentialthinking"
      ]
    },
    "arxiv-mcp-server": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "arxiv-mcp-server",
        "--storage-path",
        "~/papers",
        "--max-results",
        "50",
        "--timeout",
        "30"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "download_paper",
        "read_paper"
      ]
    },
    "ssh-remote": {
      "command": "python3",
      "args": [
        "/home/neeyuhuynh/ssh/ssh_mcp_server.py"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "ssh_connect",
        "remote_file_read",
        "remote_file_write",
        "remote_execute"
      ]
    }
  }
}